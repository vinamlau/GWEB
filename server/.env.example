# 后端环境变量
# ⚠️ 重要：这个文件包含敏感信息，不要提交到版本控制！

# 服务器端口
PORT=3001

# MongoDB 连接字符串
# 本地开发：mongodb://localhost:27017/gweb_cms
# 生产环境：使用 MongoDB Atlas 或其他云服务
MONGODB_URI=mongodb://localhost:27017/gweb_cms

# JWT 密钥 - ⚠️ 生产环境必须使用强随机密钥！
# 生成命令：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 或使用：openssl rand -base64 64
JWT_SECRET=your_jwt_secret_key_change_this_in_production

# 运行环境
NODE_ENV=development

# 文件上传路径
# Vercel 部署时使用：/tmp/uploads
UPLOAD_PATH=./uploads

# 最大文件大小 (字节) - 默认 5MB
MAX_FILE_SIZE=5242880
